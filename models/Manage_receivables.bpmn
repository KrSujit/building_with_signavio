<?xml version="1.0" encoding="UTF-8"?>
<!-- Building with SAP Signavio - companion file. Fictional company Velora Group SE. Import in SAP Signavio Process Manager: Explorer > Import > BPMN 2.0 XML. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_Manage_receivables" targetNamespace="http://velora.example/bpmn" exporter="building_with_signavio" exporterVersion="1.0">
<collaboration id="C_Manage_receivables">
  <participant id="P_Manage_receivables" name="Velora" processRef="Manage_receivables"/>
  <participant id="P_Bank" name="Bank"/>
  <messageFlow id="M_1" name="Bank statement" sourceRef="P_Bank" targetRef="m1"/>
</collaboration>
<process id="Manage_receivables" name="Manage receivables" isExecutable="false">
  <documentation>L3 as-is. Dunning runs monthly (as-is).</documentation>
  <laneSet id="LS_Manage_receivables">
    <lane id="L_Manage_receivables_0" name="Accounts Receivable"><flowNodeRef>s</flowNodeRef><flowNodeRef>gm</flowNodeRef><flowNodeRef>g</flowNodeRef><flowNodeRef>t2</flowNodeRef><flowNodeRef>e</flowNodeRef><flowNodeRef>tm</flowNodeRef><flowNodeRef>t3</flowNodeRef></lane>
    <lane id="L_Manage_receivables_1" name="SAP ECC"><flowNodeRef>m1</flowNodeRef><flowNodeRef>t1</flowNodeRef></lane>
  </laneSet>
  <startEvent id="s" name="Invoice sent"><outgoing>F_1</outgoing></startEvent>
  <exclusiveGateway id="gm" name=""><incoming>F_1</incoming><incoming>F_9</incoming><outgoing>F_2</outgoing></exclusiveGateway>
  <eventBasedGateway id="g" name=""><incoming>F_2</incoming><outgoing>F_3</outgoing><outgoing>F_7</outgoing></eventBasedGateway>
  <intermediateCatchEvent id="m1" name="Bank statement received"><incoming>F_3</incoming><outgoing>F_4</outgoing><messageEventDefinition id="MD_m1"/></intermediateCatchEvent>
  <task id="t1" name="Receive incoming payment"><incoming>F_4</incoming><outgoing>F_5</outgoing></task>
  <task id="t2" name="Clear payment"><incoming>F_5</incoming><outgoing>F_6</outgoing></task>
  <endEvent id="e" name="Payment received"><incoming>F_6</incoming></endEvent>
  <intermediateCatchEvent id="tm" name="Due date passed"><incoming>F_7</incoming><outgoing>F_8</outgoing><timerEventDefinition id="TD_tm"/></intermediateCatchEvent>
  <task id="t3" name="Send dunning notice"><documentation>Monthly dunning run (as-is). First reminder on average 18-21 days after the due date.</documentation><incoming>F_8</incoming><outgoing>F_9</outgoing></task>
  <sequenceFlow id="F_1" name="" sourceRef="s" targetRef="gm"/>
  <sequenceFlow id="F_2" name="" sourceRef="gm" targetRef="g"/>
  <sequenceFlow id="F_3" name="" sourceRef="g" targetRef="m1"/>
  <sequenceFlow id="F_4" name="" sourceRef="m1" targetRef="t1"/>
  <sequenceFlow id="F_5" name="" sourceRef="t1" targetRef="t2"/>
  <sequenceFlow id="F_6" name="" sourceRef="t2" targetRef="e"/>
  <sequenceFlow id="F_7" name="" sourceRef="g" targetRef="tm"/>
  <sequenceFlow id="F_8" name="" sourceRef="tm" targetRef="t3"/>
  <sequenceFlow id="F_9" name="" sourceRef="t3" targetRef="gm"/>
</process>
<bpmndi:BPMNDiagram id="D_Manage_receivables" name="Manage receivables"><bpmndi:BPMNPlane id="PL_Manage_receivables" bpmnElement="C_Manage_receivables">
<bpmndi:BPMNShape id="S_P_Manage_receivables" bpmnElement="P_Manage_receivables" isHorizontal="true"><dc:Bounds x="40" y="40" width="1234.0" height="400"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_L_Manage_receivables_0" bpmnElement="L_Manage_receivables_0" isHorizontal="true"><dc:Bounds x="70" y="40" width="1204.0" height="200"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_L_Manage_receivables_1" bpmnElement="L_Manage_receivables_1" isHorizontal="true"><dc:Bounds x="70" y="240" width="1204.0" height="200"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_P_Bank" bpmnElement="P_Bank" isHorizontal="true"><dc:Bounds x="40" y="480" width="1234.0" height="90"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_s" bpmnElement="s"><dc:Bounds x="175" y="85" width="30" height="30"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_gm" bpmnElement="gm" isMarkerVisible="true"><dc:Bounds x="335" y="80" width="40" height="40"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_g" bpmnElement="g"><dc:Bounds x="459" y="80" width="40" height="40"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_m1" bpmnElement="m1"><dc:Bounds x="604" y="325" width="30" height="30"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_t1" bpmnElement="t1"><dc:Bounds x="724" y="300" width="120" height="80"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_t2" bpmnElement="t2"><dc:Bounds x="889" y="60" width="120" height="80"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_e" bpmnElement="e"><dc:Bounds x="1100" y="86" width="28" height="28"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_tm" bpmnElement="tm"><dc:Bounds x="604" y="175" width="30" height="30"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_t3" bpmnElement="t3"><dc:Bounds x="724" y="150" width="120" height="80"/></bpmndi:BPMNShape>
<bpmndi:BPMNEdge id="E_F_1" bpmnElement="F_1"><di:waypoint x="205" y="100"/><di:waypoint x="335" y="100"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="E_F_2" bpmnElement="F_2"><di:waypoint x="375" y="100"/><di:waypoint x="459" y="100"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="E_F_3" bpmnElement="F_3"><di:waypoint x="479" y="120"/><di:waypoint x="479" y="340"/><di:waypoint x="604" y="340"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="E_F_4" bpmnElement="F_4"><di:waypoint x="634" y="340"/><di:waypoint x="724" y="340"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="E_F_5" bpmnElement="F_5"><di:waypoint x="844" y="340"/><di:waypoint x="949" y="340"/><di:waypoint x="949" y="140"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="E_F_6" bpmnElement="F_6"><di:waypoint x="1009" y="100"/><di:waypoint x="1100" y="100"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="E_F_7" bpmnElement="F_7"><di:waypoint x="499" y="100"/><di:waypoint x="619" y="100"/><di:waypoint x="619" y="175"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="E_F_8" bpmnElement="F_8"><di:waypoint x="634" y="190"/><di:waypoint x="724" y="190"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="E_F_9" bpmnElement="F_9"><di:waypoint x="784" y="230"/><di:waypoint x="784" y="258"/><di:waypoint x="355" y="258"/><di:waypoint x="355" y="120"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="E_M_1" bpmnElement="M_1"><di:waypoint x="649" y="480"/><di:waypoint x="649" y="355"/></bpmndi:BPMNEdge>
</bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</definitions>
