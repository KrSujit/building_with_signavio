<bpmndi:BPMNEdge id="E_F_3" bpmnElement="F_3"><di:waypoint x="580" y="395"/><di:waypoint x="685" y="395"/><di:waypoint x="685" y="505"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="E_F_4" bpmnElement="F_4"><di:waypoint x="745" y="545"/><di:waypoint x="850" y="545"/><di:waypoint x="850" y="655"/></bpmndi:BPMNEdge>
