<bpmndi:BPMNShape id="S_L_O2C_collaboration_L2_2" bpmnElement="L_O2C_collaboration_L2_2" isHorizontal="true"><dc:Bounds x="70" y="470" width="1270" height="150"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_L_O2C_collaboration_L2_3" bpmnElement="L_O2C_collaboration_L2_3" isHorizontal="true"><dc:Bounds x="70" y="620" width="1270" height="150"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_L_O2C_collaboration_L2_4" bpmnElement="L_O2C_collaboration_L2_4" isHorizontal="true"><dc:Bounds x="70" y="770" width="1270" height="150"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_P_Customer" bpmnElement="P_Customer" isHorizontal="true"><dc:Bounds x="40" y="40" width="1300" height="90"/></bpmndi:BPMNShape>
