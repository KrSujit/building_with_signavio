<?xml version="1.0" encoding="UTF-8"?>
<!-- Building with SAP Signavio - companion file. Fictional company Velora Group SE. Import in SAP Signavio Process Manager: Explorer > Import > BPMN 2.0 XML. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_O2C_collaboration_L2" targetNamespace="http://velora.example/bpmn" exporter="building_with_signavio" exporterVersion="1.0">
<collaboration id="C_O2C_collaboration_L2">
  <participant id="P_O2C_collaboration_L2" name="Velora" processRef="O2C_collaboration_L2"/>
  <participant id="P_Customer" name="Customer"/>
  <participant id="P_Carrier" name="Carrier"/>
  <participant id="P_Bank" name="Bank"/>
  <messageFlow id="M_1" name="Purchase order" sourceRef="P_Customer" targetRef="p1"/>
  <messageFlow id="M_2" name="Order confirmation" sourceRef="p1" targetRef="P_Customer"/>
  <messageFlow id="M_3" name="Invoice" sourceRef="p4" targetRef="P_Customer"/>
  <messageFlow id="M_4" name="Transport order" sourceRef="p3" targetRef="P_Carrier"/>
  <messageFlow id="M_5" name="Proof of delivery" sourceRef="P_Carrier" targetRef="p3"/>
  <messageFlow id="M_6" name="Bank statement" sourceRef="P_Bank" targetRef="p5"/>
</collaboration>
<process id="O2C_collaboration_L2" name="Order to Cash - collaboration (L2)" isExecutable="false">
  <documentation>L2. Owner: O2C Process Owner. Each collapsed subprocess links to its L3 model.</documentation>
  <laneSet id="LS_O2C_collaboration_L2">
    <lane id="L_O2C_collaboration_L2_0" name="Sales Operations"><flowNodeRef>s</flowNodeRef><flowNodeRef>p1</flowNodeRef></lane>
    <lane id="L_O2C_collaboration_L2_1" name="Credit Management"><flowNodeRef>p2</flowNodeRef></lane>
    <lane id="L_O2C_collaboration_L2_2" name="Logistics"><flowNodeRef>p3</flowNodeRef></lane>
    <lane id="L_O2C_collaboration_L2_3" name="Billing"><flowNodeRef>p4</flowNodeRef></lane>
    <lane id="L_O2C_collaboration_L2_4" name="Accounts Receivable"><flowNodeRef>p5</flowNodeRef><flowNodeRef>e</flowNodeRef></lane>
  </laneSet>
  <startEvent id="s" name="Customer purchase order received"><outgoing>F_1</outgoing></startEvent>
  <subProcess id="p1" name="Process customer order"><incoming>F_1</incoming><outgoing>F_2</outgoing></subProcess>
  <subProcess id="p2" name="Manage credit"><documentation>End events of the L3 model: Credit released, Order rejected.</documentation><incoming>F_2</incoming><outgoing>F_3</outgoing></subProcess>
  <subProcess id="p3" name="Deliver goods"><incoming>F_3</incoming><outgoing>F_4</outgoing></subProcess>
  <subProcess id="p4" name="Bill customer"><incoming>F_4</incoming><outgoing>F_5</outgoing></subProcess>
  <subProcess id="p5" name="Manage receivables"><incoming>F_5</incoming><outgoing>F_6</outgoing></subProcess>
  <endEvent id="e" name="Payment received"><incoming>F_6</incoming></endEvent>
  <sequenceFlow id="F_1" name="" sourceRef="s" targetRef="p1"/>
  <sequenceFlow id="F_2" name="" sourceRef="p1" targetRef="p2"/>
  <sequenceFlow id="F_3" name="" sourceRef="p2" targetRef="p3"/>
  <sequenceFlow id="F_4" name="" sourceRef="p3" targetRef="p4"/>
  <sequenceFlow id="F_5" name="" sourceRef="p4" targetRef="p5"/>
  <sequenceFlow id="F_6" name="" sourceRef="p5" targetRef="e"/>
</process>
<bpmndi:BPMNDiagram id="D_O2C_collaboration_L2" name="Order to Cash - collaboration (L2)"><bpmndi:BPMNPlane id="PL_O2C_collaboration_L2" bpmnElement="C_O2C_collaboration_L2">
<bpmndi:BPMNShape id="S_P_O2C_collaboration_L2" bpmnElement="P_O2C_collaboration_L2" isHorizontal="true"><dc:Bounds x="40" y="170" width="1300" height="750"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_L_O2C_collaboration_L2_0" bpmnElement="L_O2C_collaboration_L2_0" isHorizontal="true"><dc:Bounds x="70" y="170" width="1270" height="150"/></bpmndi:BPMNShape>
