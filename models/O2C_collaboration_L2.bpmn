<bpmndi:BPMNShape id="S_p5" bpmnElement="p5" isExpanded="false"><dc:Bounds x="955" y="805" width="120" height="80"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_e" bpmnElement="e"><dc:Bounds x="1166" y="831" width="28" height="28"/></bpmndi:BPMNShape>
