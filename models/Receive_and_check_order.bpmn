<bpmndi:BPMNShape id="S_t5" bpmnElement="t5"><dc:Bounds x="1285" y="75" width="120" height="80"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_t6" bpmnElement="t6"><dc:Bounds x="1450" y="75" width="120" height="80"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_e" bpmnElement="e"><dc:Bounds x="1661" y="101" width="28" height="28"/></bpmndi:BPMNShape>
<bpmndi:BPMNEdge id="E_F_1" bpmnElement="F_1"><di:waypoint x="205" y="115"/><di:waypoint x="295" y="115"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="E_F_2" bpmnElement="F_2"><di:waypoint x="415" y="115"/><di:waypoint x="460" y="115"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="E_F_3" bpmnElement="F_3"><di:waypoint x="580" y="115"/><di:waypoint x="665" y="115"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="E_F_4" bpmnElement="F_4"><di:waypoint x="705" y="115"/><di:waypoint x="995" y="115"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="E_F_5" bpmnElement="F_5"><di:waypoint x="685" y="135"/><di:waypoint x="685" y="265"/><di:waypoint x="790" y="265"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="E_F_6" bpmnElement="F_6"><di:waypoint x="910" y="265"/><di:waypoint x="1015" y="265"/><di:waypoint x="1015" y="135"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="E_F_7" bpmnElement="F_7"><di:waypoint x="1035" y="115"/><di:waypoint x="1120" y="115"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="E_F_8" bpmnElement="F_8"><di:waypoint x="1240" y="115"/><di:waypoint x="1285" y="115"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="E_F_9" bpmnElement="F_9"><di:waypoint x="1405" y="115"/><di:waypoint x="1450" y="115"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="E_F_10" bpmnElement="F_10"><di:waypoint x="1570" y="115"/><di:waypoint x="1661" y="115"/></bpmndi:BPMNEdge>
</bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
