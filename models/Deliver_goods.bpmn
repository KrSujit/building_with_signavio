<?xml version="1.0" encoding="UTF-8"?>
<!-- Building with SAP Signavio - companion file. Fictional company Velora Group SE. Import in SAP Signavio Process Manager: Explorer > Import > BPMN 2.0 XML. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_Deliver_goods" targetNamespace="http://velora.example/bpmn" exporter="building_with_signavio" exporterVersion="1.0">
<collaboration id="C_Deliver_goods">
  <participant id="P_Deliver_goods" name="Velora" processRef="Deliver_goods"/>
</collaboration>
<process id="Deliver_goods" name="Deliver goods" isExecutable="false">
  <documentation>L3 as-is. Activities as in the event log: Create delivery, Pick goods, Post goods issue.</documentation>
  <laneSet id="LS_Deliver_goods">
    <lane id="L_Deliver_goods_0" name="Logistics"><flowNodeRef>s</flowNodeRef><flowNodeRef>t1</flowNodeRef><flowNodeRef>t2</flowNodeRef><flowNodeRef>t3</flowNodeRef><flowNodeRef>t5</flowNodeRef><flowNodeRef>e</flowNodeRef></lane>
    <lane id="L_Deliver_goods_1" name="SAP ECC"><flowNodeRef>t4</flowNodeRef></lane>
  </laneSet>
  <startEvent id="s" name="Order released for delivery"><outgoing>F_1</outgoing></startEvent>
  <task id="t1" name="Create delivery"><documentation>SAP ECC VL01N. One order can have several deliveries (partial deliveries).</documentation><incoming>F_1</incoming><outgoing>F_2</outgoing></task>
  <task id="t2" name="Pick goods"><documentation>Warehouse transfer order (LTAK).</documentation><incoming>F_2</incoming><outgoing>F_3</outgoing></task>
  <task id="t3" name="Pack and load"><incoming>F_3</incoming><outgoing>F_4</outgoing></task>
  <task id="t4" name="Post goods issue"><documentation>Material document, movement type 601.</documentation><incoming>F_4</incoming><outgoing>F_5</outgoing></task>
  <task id="t5" name="Hand over to carrier"><incoming>F_5</incoming><outgoing>F_6</outgoing></task>
  <endEvent id="e" name="Goods shipped"><incoming>F_6</incoming></endEvent>
  <sequenceFlow id="F_1" name="" sourceRef="s" targetRef="t1"/>
  <sequenceFlow id="F_2" name="" sourceRef="t1" targetRef="t2"/>
  <sequenceFlow id="F_3" name="" sourceRef="t2" targetRef="t3"/>
  <sequenceFlow id="F_4" name="" sourceRef="t3" targetRef="t4"/>
  <sequenceFlow id="F_5" name="" sourceRef="t4" targetRef="t5"/>
  <sequenceFlow id="F_6" name="" sourceRef="t5" targetRef="e"/>
</process>
<bpmndi:BPMNDiagram id="D_Deliver_goods" name="Deliver goods"><bpmndi:BPMNPlane id="PL_Deliver_goods" bpmnElement="C_Deliver_goods">
<bpmndi:BPMNShape id="S_P_Deliver_goods" bpmnElement="P_Deliver_goods" isHorizontal="true"><dc:Bounds x="40" y="40" width="1300" height="300"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_L_Deliver_goods_0" bpmnElement="L_Deliver_goods_0" isHorizontal="true"><dc:Bounds x="70" y="40" width="1270" height="150"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_L_Deliver_goods_1" bpmnElement="L_Deliver_goods_1" isHorizontal="true"><dc:Bounds x="70" y="190" width="1270" height="150"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_s" bpmnElement="s"><dc:Bounds x="175" y="100" width="30" height="30"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_t1" bpmnElement="t1"><dc:Bounds x="295" y="75" width="120" height="80"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_t2" bpmnElement="t2"><dc:Bounds x="460" y="75" width="120" height="80"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_t3" bpmnElement="t3"><dc:Bounds x="625" y="75" width="120" height="80"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_t4" bpmnElement="t4"><dc:Bounds x="790" y="225" width="120" height="80"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_t5" bpmnElement="t5"><dc:Bounds x="955" y="75" width="120" height="80"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_e" bpmnElement="e"><dc:Bounds x="1166" y="101" width="28" height="28"/></bpmndi:BPMNShape>
<bpmndi:BPMNEdge id="E_F_1" bpmnElement="F_1"><di:waypoint x="205" y="115"/><di:waypoint x="295" y="115"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="E_F_2" bpmnElement="F_2"><di:waypoint x="415" y="115"/><di:waypoint x="460" y="115"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="E_F_3" bpmnElement="F_3"><di:waypoint x="580" y="115"/><di:waypoint x="625" y="115"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="E_F_4" bpmnElement="F_4"><di:waypoint x="745" y="115"/><di:waypoint x="850" y="115"/><di:waypoint x="850" y="225"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="E_F_5" bpmnElement="F_5"><di:waypoint x="910" y="265"/><di:waypoint x="1015" y="265"/><di:waypoint x="1015" y="155"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="E_F_6" bpmnElement="F_6"><di:waypoint x="1075" y="115"/><di:waypoint x="1166" y="115"/></bpmndi:BPMNEdge>
</bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</definitions>
