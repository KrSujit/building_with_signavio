<?xml version="1.0" encoding="UTF-8"?>
<!-- Building with SAP Signavio - companion file. Fictional company Velora Group SE. Import in SAP Signavio Process Manager: Explorer > Import > BPMN 2.0 XML. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_Release_credit_block_Brno_as_is" targetNamespace="http://velora.example/bpmn" exporter="building_with_signavio" exporterVersion="1.0">
<collaboration id="C_Release_credit_block_Brno_as_is">
  <participant id="P_Release_credit_block_Brno_as_is" name="Velora" processRef="Release_credit_block_Brno_as_is"/>
</collaboration>
<process id="Release_credit_block_Brno_as_is" name="Release credit block (Brno) - as-is" isExecutable="false">
  <documentation>L3 as-is, Brno. Owner: O2C Process Owner. Site applicability: Brno. S/4HANA wave: Wave 1.</documentation>
  <laneSet id="LS_Release_credit_block_Brno_as_is">
    <lane id="L_Release_credit_block_Brno_as_is_0" name="SAP ECC"><flowNodeRef>s</flowNodeRef></lane>
    <lane id="L_Release_credit_block_Brno_as_is_1" name="Order Desk Clerk (Brno)"><flowNodeRef>t1</flowNodeRef><flowNodeRef>g1</flowNodeRef><flowNodeRef>t2</flowNodeRef><flowNodeRef>m0</flowNodeRef><flowNodeRef>gm</flowNodeRef><flowNodeRef>g2</flowNodeRef><flowNodeRef>m1</flowNodeRef><flowNodeRef>tm2</flowNodeRef><flowNodeRef>t5</flowNodeRef><flowNodeRef>tm1</flowNodeRef></lane>
    <lane id="L_Release_credit_block_Brno_as_is_2" name="Credit Analyst (Pune GCC)"><flowNodeRef>t3</flowNodeRef><flowNodeRef>g3</flowNodeRef><flowNodeRef>t4</flowNodeRef><flowNodeRef>e1</flowNodeRef><flowNodeRef>e2</flowNodeRef><flowNodeRef>t8</flowNodeRef><flowNodeRef>e4</flowNodeRef><flowNodeRef>b1</flowNodeRef></lane>
    <lane id="L_Release_credit_block_Brno_as_is_3" name="Sales Representative"><flowNodeRef>t6</flowNodeRef><flowNodeRef>t7</flowNodeRef><flowNodeRef>e3</flowNodeRef></lane>
  </laneSet>
  <startEvent id="s" name="Order blocked for credit"><outgoing>F_1</outgoing></startEvent>
  <task id="t1" name="Check trusted customer list"><documentation>Pain point: list maintained locally in Excel, no owner in finance.</documentation><incoming>F_1</incoming><outgoing>F_2</outgoing></task>
  <exclusiveGateway id="g1" name="Customer on trusted list?"><incoming>F_2</incoming><outgoing>F_3</outgoing><outgoing>F_16</outgoing></exclusiveGateway>
  <task id="t2" name="Send release request to Pune"><incoming>F_3</incoming><outgoing>F_4</outgoing></task>
  <intermediateThrowEvent id="m0" name="Release request sent"><incoming>F_4</incoming><outgoing>F_5</outgoing><messageEventDefinition id="MD_m0"/></intermediateThrowEvent>
  <exclusiveGateway id="gm" name=""><incoming>F_5</incoming><incoming>F_11</incoming><outgoing>F_6</outgoing></exclusiveGateway>
  <eventBasedGateway id="g2" name=""><incoming>F_6</incoming><outgoing>F_7</outgoing><outgoing>F_8</outgoing></eventBasedGateway>
  <intermediateCatchEvent id="m1" name="Release received"><incoming>F_7</incoming><outgoing>F_9</outgoing><messageEventDefinition id="MD_m1"/></intermediateCatchEvent>
  <intermediateCatchEvent id="tm2" name="48 hours passed"><incoming>F_8</incoming><outgoing>F_10</outgoing><timerEventDefinition id="TD_tm2"/></intermediateCatchEvent>
  <task id="t5" name="Call credit analyst"><documentation>Pain point: Pune queue sorted by date, not by urgency.</documentation><incoming>F_10</incoming><outgoing>F_11</outgoing></task>
  <task id="t3" name="Review blocked order"><incoming>F_9</incoming><outgoing>F_12</outgoing></task>
  <exclusiveGateway id="g3" name="Order released?"><incoming>F_12</incoming><outgoing>F_13</outgoing><outgoing>F_14</outgoing></exclusiveGateway>
  <task id="t4" name="Release credit block"><incoming>F_13</incoming><outgoing>F_15</outgoing></task>
  <endEvent id="e1" name="Credit block released"><incoming>F_15</incoming></endEvent>
  <endEvent id="e2" name="Order rejected"><incoming>F_14</incoming></endEvent>
  <intermediateCatchEvent id="tm1" name="2 working days passed"><documentation>Pain point: average wait 2.6 days.</documentation><incoming>F_16</incoming><outgoing>F_17</outgoing><timerEventDefinition id="TD_tm1"/></intermediateCatchEvent>
  <task id="t6" name="Ask Sales to contact customer"><incoming>F_17</incoming><outgoing>F_18</outgoing></task>
  <task id="t7" name="Contact customer about payment"><incoming>F_18</incoming><outgoing>F_19</outgoing></task>
  <endEvent id="e3" name="Customer contacted"><incoming>F_19</incoming></endEvent>
  <task id="t8" name="Escalate to Head of Credit"><incoming>F_20</incoming><outgoing>F_21</outgoing></task>
  <endEvent id="e4" name="Escalated"><incoming>F_21</incoming></endEvent>
  <boundaryEvent id="b1" name="24 hours" attachedToRef="t3" cancelActivity="false"><outgoing>F_20</outgoing><timerEventDefinition id="TD_b1"/></boundaryEvent>
  <sequenceFlow id="F_1" name="" sourceRef="s" targetRef="t1"/>
  <sequenceFlow id="F_2" name="" sourceRef="t1" targetRef="g1"/>
  <sequenceFlow id="F_3" name="yes" sourceRef="g1" targetRef="t2"/>
  <sequenceFlow id="F_4" name="" sourceRef="t2" targetRef="m0"/>
  <sequenceFlow id="F_5" name="" sourceRef="m0" targetRef="gm"/>
  <sequenceFlow id="F_6" name="" sourceRef="gm" targetRef="g2"/>
  <sequenceFlow id="F_7" name="" sourceRef="g2" targetRef="m1"/>
  <sequenceFlow id="F_8" name="" sourceRef="g2" targetRef="tm2"/>
  <sequenceFlow id="F_9" name="" sourceRef="m1" targetRef="t3"/>
  <sequenceFlow id="F_10" name="" sourceRef="tm2" targetRef="t5"/>
  <sequenceFlow id="F_11" name="" sourceRef="t5" targetRef="gm"/>
  <sequenceFlow id="F_12" name="" sourceRef="t3" targetRef="g3"/>
  <sequenceFlow id="F_13" name="yes" sourceRef="g3" targetRef="t4"/>
  <sequenceFlow id="F_14" name="no" sourceRef="g3" targetRef="e2"/>
  <sequenceFlow id="F_15" name="" sourceRef="t4" targetRef="e1"/>
  <sequenceFlow id="F_16" name="no" sourceRef="g1" targetRef="tm1"/>
  <sequenceFlow id="F_17" name="" sourceRef="tm1" targetRef="t6"/>
  <sequenceFlow id="F_18" name="" sourceRef="t6" targetRef="t7"/>
  <sequenceFlow id="F_19" name="" sourceRef="t7" targetRef="e3"/>
  <sequenceFlow id="F_20" name="" sourceRef="b1" targetRef="t8"/>
  <sequenceFlow id="F_21" name="" sourceRef="t8" targetRef="e4"/>
</process>
