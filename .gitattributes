# Default: normalize text files
* text=auto eol=lf

# Text formats used in this repository
*.bpmn  text eol=lf
*.dmn   text eol=lf
*.csv   text eol=lf
*.md    text eol=lf
*.sql   text eol=lf
*.json  text eol=lf
*.js    text eol=lf
*.mjs   text eol=lf
*.py    text eol=lf
*.txt   text eol=lf
*.cff   text eol=lf

# Binary formats
*.zip   binary
*.xlsx  binary
*.docx  binary
*.pptx  binary
*.pdf   binary
*.png   binary
*.jpg   binary
